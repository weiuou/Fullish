# syntax=docker/dockerfile:1.7
FROM python:3.13.16-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641
# Independent, credential-free image. Dependencies are installed here by maintainers.
RUN mkdir -p /workspace /opt/fullish && chown 10001:10001 /workspace
COPY src/fullish/sandbox_worker.py /opt/fullish/worker.py
COPY src/fullish/sandbox_files.py /opt/fullish/sandbox_files.py
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["python3", "-I", "/opt/fullish/worker.py"]
CMD ["--idle"]
