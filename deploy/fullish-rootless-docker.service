[Unit]
Description=Fullish dedicated Rootless Docker
Requires=dbus.socket
After=dbus.socket

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/dockerd-rootless.sh
ExecReload=/bin/kill -s HUP $MAINPID
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Restart=always
RestartSec=2
TimeoutSec=0
Delegate=yes
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=0
TasksMax=infinity
KillMode=mixed

[Install]
WantedBy=default.target
