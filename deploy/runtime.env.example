# Installed once as /opt/fullish/runtime.env, mode 0600.
# Keep application secrets on the server. Blank AI settings run the foundation.
ENVIRONMENT=production
LOG_LEVEL=INFO
# Keep container PORT=8080; Compose exposes it on localhost:18080 only.
# Do not override APP_REVISION: it identifies the code baked into the image.

# Set these three together when connecting CPA. The model must appear in /v1/models.
# AI_BASE_URL=http://localhost/v1
# AI_API_KEY=replace-on-server
# AI_MODEL=gemini-3.8-flash-high
# One text-request failover within the same turn; blank disables it.
# AI_FALLBACK_MODEL=gpt-6-luna
# AI_UNIX_SOCKET=/run/fullish-cpa/api.sock
# GPT Image generation reuses the same CPA URL, key and socket.
# Uses /v1/images/generations; use an exact CPA model ID or off to disable.
# AI_IMAGE_MODEL=gpt-image-2.5
# AI_IMAGE_TIMEOUT_SECONDS=120

# Enable after creating an official QQ bot and configuring its credentials.
QQ_ENABLED=false
# QQ_APP_ID=
# QQ_APP_SECRET=
# QQ_ALLOWED_GROUPS=group_openid_1,group_openid_2
# Optional post-deployment reports. Use the official group OpenID, not a QQ group number.
QQ_DEPLOY_REPORT_GROUP_OPENID=
DEPLOY_REPORT_REPOSITORY=weiuou/Fullish
# Optional tools: explicit group OpenIDs required; leave everything blank to disable.
TOOLS_ALLOWED_GROUPS=
DEEPSEEK_API_KEY=
SANDBOX_SOCKET=
SANDBOX_TOKEN=
